# ==============================================================================
# irisOS - Toybox Core Configuration (build/toybox.config)
# ==============================================================================
# Defconfig enabling core utilities (sh, ls, cat, echo, pwd, uname, clear,
# mkdir, cp, rm, touch, wc, grep, sleep, kill) configured for posix_spawn /
# no-fork operation (CONFIG_TOYBOX_FORCE_NOMMU=y).
# ==============================================================================

# Global settings
CONFIG_TOYBOX=y
CONFIG_TOYBOX_SUID=y
CONFIG_TOYBOX_LSM_NONE=y
# CONFIG_TOYBOX_SELINUX is not set
# CONFIG_TOYBOX_SMACK is not set
# CONFIG_TOYBOX_LIBCRYPTO is not set
# CONFIG_TOYBOX_LIBZ is not set
CONFIG_TOYBOX_FLOAT=y
CONFIG_TOYBOX_HELP=y
CONFIG_TOYBOX_HELP_DASHDASH=y
# CONFIG_TOYBOX_ZHELP is not set
# CONFIG_TOYBOX_FREE is not set
# CONFIG_TOYBOX_NORECURSE is not set
# CONFIG_TOYBOX_DEBUG is not set
CONFIG_TOYBOX_UID_SYS=100
CONFIG_TOYBOX_UID_USR=500
CONFIG_TOYBOX_FORCE_NOMMU=y
# CONFIG_TOYBOX_FORK is not set

# Core POSIX Utilities
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_ECHO=y
CONFIG_GREP=y
CONFIG_KILL=y
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_PWD=y
CONFIG_RM=y
CONFIG_SLEEP=y
CONFIG_TOUCH=y
CONFIG_UNAME=y
CONFIG_WC=y

# Shell and Terminal Utilities
CONFIG_CLEAR=y
CONFIG_SH=y
