# Build artifacts
out/
build/out/

# Fetched kernel tree (managed via scripts/fetch_zircon.sh)
kernel/zircon/*
!kernel/zircon/.gitkeep

# Fetched third-party submodules (managed via scripts/fetch_*.sh)
vendor/mlibc/*
!vendor/mlibc/.gitkeep
vendor/compiler-rt/*
!vendor/compiler-rt/.gitkeep
vendor/lwext4/*
!vendor/lwext4/.gitkeep
vendor/fatfs/*
!vendor/fatfs/.gitkeep
vendor/mbedtls/*
!vendor/mbedtls/.gitkeep
vendor/toybox/*
!vendor/toybox/.gitkeep
vendor/pixman/*
!vendor/pixman/.gitkeep
vendor/freetype/*
!vendor/freetype/.gitkeep

# macOS system files
.DS_Store
._*

# Temporary editor / tooling files
*.swp
*.swo
*~
.vscode/
.idea/
compile_commands.json
